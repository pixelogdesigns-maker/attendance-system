# Copy to .env and fill in. Never commit the real .env file.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/attendance
# Long random string used to sign login tokens
AUTH_SECRET=change-me-to-a-long-random-string
# Number of proxies in front of the server (1 on most hosts, 0 when run directly).
# Used to read the employee's real internet address for the office Wi-Fi check.
TRUST_PROXY=1
# Frontend address allowed to call the API (comma-separated for several)
CLIENT_ORIGIN=http://localhost:5173

# WhatsApp Business Platform (Cloud API). Leave blank to log alerts without sending.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Owner's number in international format without "+", e.g. 919876543210
OWNER_PHONE=
# Approved template name with 3 body parameters: {{1}} employee, {{2}} event, {{3}} time.
# Business-initiated messages need an approved template. If blank, a plain text message is sent,
# which WhatsApp only delivers inside a 24-hour conversation window.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Used once by `npm run seed` to create the owner account and the office.
# OFFICE_LAT/OFFICE_LNG are only needed if you switch the office to GPS checking.
OWNER_NAME=Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me
OFFICE_NAME=Main office
OFFICE_LAT=
OFFICE_LNG=
